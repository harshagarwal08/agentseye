{
  "name": "agentseye",
  "version": "0.9.0",
  "description": "Watch and drive every coding agent on your Mac from your phone: Claude Code, Codex, Gemini CLI, OpenCode, Cursor, Copilot, Aider and more. End-to-end encrypted, bring your own relay.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "agentseye": "bin/agentseye.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --experimental-test-module-mocks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "keywords": [
    "ai-agents",
    "aider",
    "claude-code",
    "cloudflare-workers",
    "codex",
    "copilot",
    "cursor",
    "developer-tools",
    "gemini-cli",
    "iterm2",
    "macos",
    "opencode",
    "phone",
    "pwa",
    "remote",
    "tmux"
  ],
  "os": [
    "darwin"
  ],
  "files": [
    "bin",
    "server",
    "public",
    "hooks",
    "relay/core.js",
    "relay/install.js",
    "relay/worker.js",
    "relay/mac-room.js",
    "relay/server.js",
    "relay/package.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshagarwal08/agentseye.git"
  }
}
