{
  "name": "agentseye",
  "version": "0.4.1",
  "description": "Your coding agents, in your pocket: see and control Claude Code and Codex on your Mac from your phone. End-to-end encrypted, works on company Macs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "agentseye": "bin/agentseye.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --experimental-test-module-mocks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "remote",
    "phone",
    "pwa",
    "macos",
    "developer-tools"
  ],
  "os": [
    "darwin"
  ],
  "files": [
    "bin",
    "server",
    "public",
    "hooks",
    "relay/core.js",
    "relay/install.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshagarwal08/agentseye.git"
  }
